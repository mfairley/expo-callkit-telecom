<?xml version="1.0" encoding="utf-8"?>
<!-- Speaker well: toggle_fill_speaker_on while activated (loudspeaker on), toggle_fill
     otherwise; ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/expo_callkit_telecom_ripple_toggle">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="@color/expo_callkit_telecom_toggle_fill_speaker_on" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/expo_callkit_telecom_toggle_fill" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
