<?xml version="1.0" encoding="utf-8"?>
<!-- Mute toggle glyph: mic_off while activated (muted), mic otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/expo_callkit_telecom_ic_mic_off"
        android:state_activated="true" />
    <item android:drawable="@drawable/expo_callkit_telecom_ic_mic" />
</selector>
