# Copy to .env.local (gitignored) to build the example with your own push credentials.
# Both are optional; without them the app builds as com.example.expocallkittelecom and
# skips FCM VoIP push on Android.

# iOS bundle identifier and Android package. Must have VoIP push (APNs) and FCM set up
# for it, and match BUNDLE_ID in example/server/.env.
# BUNDLE_ID=com.example.expocallkittelecom

# Path to your Firebase config, relative to this directory. It must contain a client for
# BUNDLE_ID. Defaults to ./google-services.json, which is gitignored.
# GOOGLE_SERVICES_FILE=./google-services.json
